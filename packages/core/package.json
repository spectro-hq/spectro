{
  "name": "@spectro/core",
  "version": "0.1.0-alpha.0",
  "homepage": "https://github.com/spectro-hq/spectro/tree/main/packages/core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spectro-hq/spectro.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "test": "vitest run --exclude 'dist/**'"
  },
  "dependencies": {
    "@spectro/protocol": "workspace:*",
    "@spectro/types": "workspace:*",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
