{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectro.dev/schemas/performance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["metric", "value", "unit"],
  "properties": {
    "metric": {
      "type": "string",
      "enum": ["lcp", "inp", "cls", "fcp", "ttfb", "long_task", "navigation", "resource_timing"]
    },
    "value": { "type": "number", "minimum": 0 },
    "unit": { "type": "string", "enum": ["ms", "score"] },
    "rating": { "type": "string", "enum": ["good", "needs_improvement", "poor"] },
    "navigationType": { "type": "string", "maxLength": 64 },
    "attribution": { "$ref": "https://spectro.dev/schemas/common.schema.json#/$defs/jsonObject" }
  }
}
