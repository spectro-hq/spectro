{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectro.dev/schemas/interaction.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": { "type": "string", "maxLength": 64 },
        "id": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 64 },
        "selector": { "type": "string", "maxLength": 512 },
        "monitorId": { "type": "string", "maxLength": 128 }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    }
  }
}
