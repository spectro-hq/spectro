{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectro.dev/schemas/envelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sentAt", "items"],
  "properties": {
    "version": { "const": 1 },
    "sentAt": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "payload"],
        "properties": {
          "type": { "const": "event" },
          "payload": { "$ref": "https://spectro.dev/schemas/event.schema.json" }
        }
      }
    }
  }
}
