{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectro.dev/schemas/page.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["action"],
  "properties": {
    "action": { "type": "string", "enum": ["view", "route_change", "leave"] },
    "from": { "type": "string", "maxLength": 2048 },
    "to": { "type": "string", "maxLength": 2048 }
  }
}
