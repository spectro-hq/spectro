{
  "name": "@spectro/processor",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false && tsc -p tsconfig.check.json --pretty false",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "status": "node dist/status.js",
    "test": "vitest run --exclude 'dist/**' --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/clickhouse.integration.test.ts"
  },
  "dependencies": {
    "@clickhouse/client": "catalog:",
    "@nats-io/transport-node": "catalog:",
    "@spectro/pipeline": "workspace:*",
    "@spectro/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
