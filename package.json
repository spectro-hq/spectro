{
  "name": "spectro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm build",
    "dev": "pnpm --parallel --filter @spectro/web --filter @spectro/api --filter @spectro/ingest --filter @spectro/processor dev",
    "infra:up": "docker compose -f infra/docker/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/docker/compose.yaml down",
    "pipeline:status": "node services/processor/dist/status.js",
    "test:integration": "SPECTRO_INTEGRATION=1 pnpm --filter @spectro/integration-tests test && pnpm --filter @spectro/api test:integration && pnpm test:ops",
    "test:ops": "node --test tests/operations/*.test.mjs"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.3.4"
}
