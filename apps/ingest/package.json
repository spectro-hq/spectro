{
  "name": "@spectro/ingest",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false && tsc -p tsconfig.check.json --pretty false",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run --exclude 'dist/**'"
  },
  "dependencies": {
    "@fastify/cors": "catalog:",
    "@nats-io/transport-node": "catalog:",
    "@spectro/pipeline": "workspace:*",
    "@spectro/protocol": "workspace:*",
    "fastify": "catalog:",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@spectro/core": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
