{
  "name": "@spectro/api",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "migrations"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false && tsc -p tsconfig.check.json --pretty false",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "migrate:production": "node dist/migrate.js",
    "start": "node dist/server.js",
    "test": "vitest run --exclude 'dist/**' --exclude '**/*.integration.test.ts'",
    "test:integration": "pnpm migrate && vitest run src/*.integration.test.ts"
  },
  "dependencies": {
    "@clickhouse/client": "catalog:",
    "@fastify/cors": "catalog:",
    "@spectro/protocol": "workspace:*",
    "fastify": "catalog:",
    "postgres": "^3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:",
    "vitest": "catalog:"
  }
}
