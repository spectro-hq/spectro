{
  "name": "@spectro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false && tsc -p tsconfig.check.json --pretty false",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run --exclude 'dist/**' --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/clickhouse-events.integration.test.ts"
  },
  "dependencies": {
    "@clickhouse/client": "catalog:",
    "@fastify/cors": "catalog:",
    "@spectro/protocol": "workspace:*",
    "fastify": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
