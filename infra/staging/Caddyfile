{$CONSOLE_HOST} {
	handle /v1/* {
		reverse_proxy api:4400
	}
	handle /health {
		reverse_proxy api:4400
	}
	handle /app {
		redir /app/ permanent
	}
	handle_path /app/* {
		root * /srv
		rewrite * /app/index.html
		file_server
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

{$INGEST_HOST} {
	reverse_proxy ingest:4401
}
